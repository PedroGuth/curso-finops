{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonApprovedInstanceTypes",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "ForAnyValue:StringNotLike": {
          "ec2:InstanceType": [
            "t3.micro",
            "t3.small",
            "t3.medium",
            "t3.large",
            "t3a.*",
            "m6i.large",
            "m6i.xlarge"
          ]
        }
      }
    }
  ]
}
